{
  "name": "fruitgpt",
  "productName": "FruitGPT",
  "version": "0.1.0",
  "description": "Chat with a real fruit fly brain: 165,122 neurons running on your computer, translated into English.",
  "main": "src/main.js",
  "license": "MIT",
  "author": "FruitGPT contributors",
  "homepage": "https://a-hackers-guide.github.io/FruitGPT/",
  "repository": "github:A-Hackers-Guide/FruitGPT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.ahackersguide.fruitgpt",
    "productName": "FruitGPT",
    "files": ["src/**/*", "package.json", "LICENSE"],
    "extraResources": [{ "from": "data", "to": "data" }, { "from": "DATA_LICENSE.md", "to": "DATA_LICENSE.md" }],
    "directories": { "output": "dist", "buildResources": "build" },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": { "target": "AppImage", "category": "Education", "icon": "build/icon.png" },
    "mac": { "category": "public.app-category.education", "icon": "build/icon.png", "identity": null },
    "win": { "icon": "build/icon.png" },
    "portable": { "artifactName": "${productName}-${version}-windows-${arch}.exe" }
  }
}
